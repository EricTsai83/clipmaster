{
  "name": "clipmaster",
  "productName": "Clipmaster",
  "version": "1.0.0",
  "description": "An application for keeping track of your clipboard history.",
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "oxlint --deny-warnings --react-plugin --jsx-a11y-plugin src tests scripts forge.config.ts vite.main.config.ts vite.renderer.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mts",
    "test:electron": "node scripts/smoke-electron.cjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "keywords": [],
  "author": {
    "name": "Steve Kinney",
    "email": "hello@stevekinney.net"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.2.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
